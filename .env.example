# ==========================================
# MAISON MIPA LEAD HUB - ENVIRONMENT CONFIG
# ==========================================

# Next.js App
NEXT_PUBLIC_APP_NAME="Maison MIPA Lead Hub"
PORT=3000

# Worker Settings
WORKER_POLL_INTERVAL_DEFAULT=150
PLAYWRIGHT_HEADLESS=true
FACEBOOK_SESSION_ENCRYPTION_KEY="mipa-secret-encryption-key-32chars!"

# AI Provider Configuration (Optional: fallback to smart rule engine if not set)
OPENAI_API_KEY=""
AI_MODEL_NAME="gpt-4o-mini"

# Meta Graph API (Optional for direct Page sync)
META_PAGE_ACCESS_TOKEN=""
META_PAGE_ID=""

# Supabase Database & Auth (Optional: in-memory / JSON store fallback is enabled by default for zero-setup start)
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/mipa_lead_hub"

# Redis & BullMQ
REDIS_URL="redis://localhost:6379"

# Staff Passwords & Security Secrets (Mandatory)
APP_SECRET="generate-a-strong-32char-secret"
MIPA_ADMIN_PASSWORD="set-your-secure-admin-password"
MIPA_MARKETING_PASSWORD="set-your-secure-marketing-password"
MIPA_CSKH_PASSWORD="set-your-secure-cskh-password"
INTERNAL_WORKER_KEY="set-your-internal-worker-key-min-16chars"
